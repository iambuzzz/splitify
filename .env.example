# Copy to .env.local (git-ignored) and fill in. Never commit or paste the real values.

# API (apps/api). A login role that may `set role app_api` (see docs/api.md), never the postgres superuser.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_URL=https://ifqcjehhdqpyiehnkorw.supabase.co
# DATABASE_CA_CERT=./supabase/prod-ca-2021.crt
# PORT=3001
# HOST=127.0.0.1
# CORS_ORIGINS=http://localhost:8081
# RATE_LIMIT_PER_MINUTE=300
# TRUST_PROXY=0

# Sign-in emails sent by the API (6-digit code + a "Sign in" button), through Resend.
# Leave both keys out and the app uses Supabase's built-in email (a link only).
# SUPABASE_SECRET_KEY=sb_secret_...   (Supabase → Project Settings → API Keys → Secret keys; server only)
# RESEND_API_KEY=re_...                (resend.com → API Keys)
# EMAIL_FROM=Splitify <onboarding@resend.dev>
# APP_URL=http://localhost:8081        (where the email's button opens; default: first CORS origin)
