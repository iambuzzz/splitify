# Splitify: the web app and the API on one server. Caddy gets and renews the HTTPS certificates itself.

splitify.iambuzzdev.in {
	root * /srv/splitify/web
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
	# Built scripts have a content hash in their names, so browsers may keep them for good;
	# everything else (index.html above all) is checked again on each visit.
	@hashed path /_expo/static/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	header ?Cache-Control "no-cache"
	# One-page app: every path (/join, /auth/callback, /group/…) loads index.html.
	try_files {path} /index.html
	file_server
}

api.splitify.iambuzzdev.in {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy 127.0.0.1:3001
}
