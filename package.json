{
  "name": "expense-platform",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:pg": "node tools/test-pg.mjs",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "audit": "node tools/audit-check.mjs",
    "check": "npm run typecheck && npm run typecheck -w @app/client && npm run test",
    "app": "npm run web -w @app/client",
    "db:login": "npx --yes supabase@2.121.0 login",
    "db:link": "npx --yes supabase@2.121.0 link --project-ref ifqcjehhdqpyiehnkorw",
    "db:push": "npx --yes supabase@2.121.0 db push",
    "db:api-login": "node tools/api-login.mjs",
    "api": "npm run dev -w @app/api"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
